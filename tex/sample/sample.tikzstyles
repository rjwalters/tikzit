% Node styles
\tikzset{red node/.style={fill=red, tikzit category=nodes, shape=circle, draw=black}}
\tikzset{blue node/.style={fill=blue, shape=circle, draw=black, tikzit category=nodes}}
\tikzset{green node/.style={tikzit fill=green, fill=green, shape=circle, draw=black, tikzit category=nodes}}
\tikzset{yellow square/.style={draw=black, fill=yellow, shape=rectangle}}
\tikzset{blue node 2/.style={fill={rgb,255: red,128; green,0; blue,128}, draw=black, shape=circle, tikzit fill=blue}}

